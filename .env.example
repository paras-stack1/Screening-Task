# =====================================================================
# BalSwasthya AI - root environment (used by infrastructure/docker-compose.yml)
# Copy to .env and change the values:   Copy-Item .env.example .env
# Never commit .env. Use synthetic data only in development.
#
# Each service has its own .env.example as well:
#   services/api/.env.example          (backend secrets: DB URL, JWT, AI key)
#   services/ai-service/.env.example   (AI placeholder)
#   apps/worker-app/.env.example       (PUBLIC values only - EXPO_PUBLIC_*)
# =====================================================================

# Local PostgreSQL container (Docker Compose)
POSTGRES_USER=balswasthya
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=balswasthya_dev
# Host port. 5433 avoids clashing with a natively installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
