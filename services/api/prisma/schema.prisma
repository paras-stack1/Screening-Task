// BalSwasthya AI - Prisma schema (Prisma ORM 6)
//
// Source of truth for the design: docs/database-design.md (approved v0.1, 2026-11-21).
// Change the design document first, then this file, then create a migration.
//
// Two database accounts:
//   DATABASE_URL            runtime account (balswasthya_app): data read/write only.
//   MIGRATION_DATABASE_URL  owner account: used by Prisma Migrate (via directUrl) only.
// Development and test data must be synthetic only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Prisma Migrate uses this privileged connection; the API never does.
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ===================================================================== Enums

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AssignmentScope {
  AREA_ONLY
  AREA_AND_DESCENDANTS
}

enum AssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Illustrative - align with programme forms.
enum SexAtBirth {
  FEMALE
  MALE
  OTHER
  NOT_RECORDED
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GRANDPARENT
  SIBLING
  OTHER_RELATIVE
  LEGAL_GUARDIAN
  INSTITUTION_CARETAKER
  OTHER
}

enum ConsentPurpose {
  SCREENING
  PHOTO_CAPTURE
  VIDEO_CAPTURE
  AUDIO_CAPTURE
  AI_PROCESSING
  REFERRAL_DATA_SHARING
  SMS_REMINDERS
}

enum ConsentDecision {
  GRANTED
  REFUSED
}

/// Illustrative - to be confirmed with legal / programme team.
enum ConsentMethod {
  VERBAL_WITNESSED
  SIGNATURE
  THUMB_IMPRESSION
  DIGITAL_ACKNOWLEDGEMENT
}

enum ApprovalStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum FourDCategory {
  DEFECTS_AT_BIRTH
  DEFICIENCIES
  DISEASES
  DEVELOPMENTAL_DELAYS_DISABILITIES
}

enum AnswerType {
  YES_NO
  SINGLE_CHOICE
  MULTI_CHOICE
  NUMBER
  TEXT
}

enum SessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Explicit answer states (Step 6 decision G). An unanswered question has NO row: missing data
/// is never stored as, or read as, "No". UNKNOWN != NO; NOT_ASSESSED != NO.
enum ObservationStatus {
  ANSWERED
  UNKNOWN
  NOT_ASSESSED
  /// Covers "declined" and "could not be completed".
  UNABLE_TO_ASSESS
}

/// Clinical-content lifecycle of a screening protocol (Step 6 decision B). Separate from
/// ApprovalStatus, which consent notices use. Only ACTIVE protocols are operational.
enum ProtocolStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  RETIRED
}

/// Progress of one Four-D category inside a session. "Not started" = no row.
enum CategoryProgress {
  IN_PROGRESS
  COMPLETED
}

enum ResponseSource {
  WORKER_OBSERVED
  GUARDIAN_REPORTED
}

enum MeasurementSource {
  MEASURED
  GUARDIAN_REPORTED
  FROM_RECORD
}

/// Why the amender was allowed to amend (Step 6G, decision G4).
enum AmendmentBasis {
  /// The worker who conducted the screening, within 7 x 24 h of completion.
  CONDUCTOR_WITHIN_WINDOW
  /// A screening.review holder whose area scope covers the child's current area.
  MEDICAL_OFFICER
}

enum AmendmentReviewStatus {
  NOT_REQUIRED
  PENDING
  REVIEWED
}

enum AmendmentChangeKind {
  RESPONSE
  MEASUREMENT
  CATEGORY_NOTES
}

enum ReassessmentStatus {
  PENDING
  REASSESSED
}

/// Illustrative - final list follows approved protocols.
enum MeasurementType {
  WEIGHT
  HEIGHT
  LENGTH
  MUAC
  HEAD_CIRCUMFERENCE
  HAEMOGLOBIN
}

enum MeasurementQuality {
  RELIABLE
  QUESTIONABLE
  NOT_RELIABLE
}

/// Outcome of ONE Four-D category in one screening version (Step 7 decision E). A workflow label,
/// never a diagnosis. Missing data never leads to NO_CONCERN_IN_COMPLETED_ITEMS.
enum ResultOutcome {
  /// Every rule of the applied rule set evaluated to "not met" on complete data.
  NO_CONCERN_IN_COMPLETED_ITEMS
  FURTHER_EVALUATION_RECOMMENDED
  URGENT_EVALUATION_RECOMMENDED
  /// The category was started but not finished, and no rule was met.
  INCOMPLETE
  /// The category was never started in this screening.
  NOT_ASSESSED
  /// A rule could not be evaluated (missing, unknown, unreliable or conflicting input).
  UNABLE_TO_DETERMINE
  /// No usable rule set exists: observations are shown without interpretation.
  NOT_INTERPRETED
}

enum ResultSource {
  RULE_ENGINE
  WORKER_OBSERVATION
  AI_SUPPORT
  CLINICIAN
}

/// Clinical review of a result run (Step 7 decisions G-I). Workflow states, not diagnoses.
enum ClinicalReviewStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  ESCALATED
  REVIEWED
  REJECTED
}

enum ClinicalReviewDecision {
  ACCEPT_RESULT
  REQUEST_ADDITIONAL_SCREENING
  RECOMMEND_REFERRAL
  ESCALATE_FOR_SPECIALIST_REVIEW
  REJECT_WITH_REASON
}

enum RuleSetEventType {
  CREATED
  STATUS_CHANGED
}

enum AiAnalysisType {
  IMAGE_QUALITY
  IMAGE_ANALYSIS
  SPEECH
  MOVEMENT
  DEVELOPMENTAL
  GROWTH
}

enum AiAnalysisStatus {
  REQUESTED
  COMPLETED
  FAILED
  UNAVAILABLE
}

/// Illustrative - to be confirmed.
enum FacilityType {
  DEIC
  PHC
  CHC
  DISTRICT_HOSPITAL
  MEDICAL_COLLEGE
  DESIGNATED_SPECIALIST_CENTRE
  OTHER
}

/// Clinical definitions of each level to be confirmed.
enum ReferralUrgency {
  ROUTINE
  PRIORITY
  URGENT
}

/// Referral lifecycle (Step 7 decision J; state machine in docs/step-7/architecture.md section 6).
/// REJECTED, CLOSED and CANCELLED are final.
enum ReferralStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
  ACKNOWLEDGED
  APPOINTMENT_SCHEDULED
  VISITED
  VISIT_NOT_COMPLETED
  UNDER_TREATMENT
  FOLLOW_UP_REQUIRED
  CLOSED
  CANCELLED
}

enum ReferralOrigin {
  CLINICAL_REVIEW
  RULE_RECOMMENDATION
  WORKER_CONCERN
}

/// Where a referral status update came from (decision O). Only SYSTEM / APP_USER_DIRECT are
/// first-hand; the others are reports and carry a verification status.
enum ReferralUpdateSource {
  SYSTEM
  APP_USER_DIRECT
  FACILITY_PHONE_CALL
  FACILITY_DOCUMENT_SEEN
  GUARDIAN_REPORTED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

/// Rescheduling is an event, not a status (decision Q).
enum FollowUpStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum FollowUpEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  STARTED
  RESCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
}

enum MediaStatus {
  PENDING_UPLOAD
  STORED
  QUARANTINED
  DELETED
}

enum SyncStatus {
  RECEIVED
  APPLIED
  REJECTED
  CONFLICT
}

/// In-app notifications only (decision S). The app shows generic text per type - no names or
/// health details are stored or shown.
enum NotificationType {
  REVIEW_TASK_NEW
  REVIEW_OVERDUE
  ADDITIONAL_ASSESSMENT_REQUESTED
  REFERRAL_APPROVED
  REFERRAL_REJECTED
  REFERRAL_ISSUED
  REFERRAL_ACKNOWLEDGED
  REFERRAL_APPOINTMENT_SCHEDULED
  REFERRAL_STATUS_CHANGED
  FOLLOW_UP_ASSIGNED
  FOLLOW_UP_DUE_SOON
  FOLLOW_UP_OVERDUE
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

// ============================================================ Organisation & users

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users User[]
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Employee code or mobile number - to be confirmed.
  loginId            String     @unique
  passwordHash       String
  displayName        String
  status             UserStatus @default(ACTIVE)
  organizationId     String?    @db.Uuid
  preferredLanguage  String     @default("hi")
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.Timestamptz(3)
  mustChangePassword Boolean    @default(true)
  passwordChangedAt  DateTime?  @db.Timestamptz(3)
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  assignmentsHeld         WorkerAreaAssignment[]             @relation("AssignmentHolder")
  assignmentsCreated      WorkerAreaAssignment[]             @relation("AssignmentCreatedBy")
  assignmentStatusChanges WorkerAreaAssignment[]             @relation("AssignmentStatusChangedBy")
  childrenRegistered      Child[]
  childTransfers          ChildAreaTransfer[]
  guardianLinksCreated    ChildGuardian[]                    @relation("GuardianLinkCreatedBy")
  guardianLinksEnded      ChildGuardian[]                    @relation("GuardianLinkEndedBy")
  consentsRecorded        Consent[]                          @relation("ConsentRecordedBy")
  consentsWithdrawn       Consent[]                          @relation("ConsentWithdrawnBy")
  protocolsApproved       ScreeningProtocol[]
  sessionsConducted       ScreeningSession[]                 @relation("SessionConductedBy")
  sessionsCancelled       ScreeningSession[]                 @relation("SessionCancelledBy")
  amendmentsMade          ScreeningAmendment[]               @relation("AmendmentAuthor")
  amendmentsReviewed      ScreeningAmendment[]               @relation("AmendmentReviewer")
  reassessmentsDone       ScreeningAmendmentReferralImpact[]
  observationsRecorded    ScreeningObservation[]
  measurementsRecorded    Measurement[]
  ruleSetsCreated         ClinicalRuleSet[]                  @relation("RuleSetCreatedBy")
  ruleSetsApproved        ClinicalRuleSet[]                  @relation("RuleSetApprovedBy")
  ruleSetEvents           ClinicalRuleSetEvent[]
  resultRunsGenerated     ScreeningResultRun[]
  reviewsClaimed          ClinicalReview[]                   @relation("ReviewClaimedBy")
  reviewsDecided          ClinicalReview[]                   @relation("ReviewDecidedBy")
  reviewEvents            ClinicalReviewEvent[]
  facilitiesCreated       Facility[]                         @relation("FacilityCreatedBy")
  facilitiesUpdated       Facility[]                         @relation("FacilityUpdatedBy")
  facilitiesVerified      Facility[]                         @relation("FacilityVerifiedBy")
  facilityHistory         FacilityHistory[]
  referralsCreated        Referral[]                         @relation("ReferralCreatedBy")
  referralsApproved       Referral[]                         @relation("ReferralApprovedBy")
  referralStatusEvents    ReferralStatusEvent[]
  followUpsAssigned       FollowUp[]                         @relation("FollowUpAssignee")
  followUpsAssignedBy     FollowUp[]                         @relation("FollowUpAssignedBy")
  followUpsCreated        FollowUp[]                         @relation("FollowUpCreatedBy")
  followUpsCompleted      FollowUp[]                         @relation("FollowUpCompletedBy")
  followUpEvents          FollowUpEvent[]                    @relation("FollowUpEventActor")
  followUpEventsAssigned  FollowUpEvent[]                    @relation("FollowUpEventAssignee")
  mediaCaptured           MediaMetadata[]
  notifications           Notification[]
  refreshSessions         RefreshSession[]
  syncOperations          SyncOperation[]

  @@index([status])
  @@index([organizationId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameEn      String
  nameHi      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  assignments WorkerAreaAssignment[]
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  /// Defined in API source code and seeded, e.g. "child.read".
  code        String @unique
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ================================================================ Area hierarchy

model AreaLevel {
  id                      String   @id @default(uuid()) @db.Uuid
  code                    String   @unique
  nameEn                  String
  nameHi                  String
  /// Smaller = higher in the tree. Use gaps (10, 20, ...) so levels can be inserted.
  rank                    Int      @unique
  allowsChildRegistration Boolean  @default(false)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  areas Area[]
}

model Area {
  id            String    @id @default(uuid()) @db.Uuid
  levelId       String    @db.Uuid
  parentId      String?   @db.Uuid
  code          String
  /// Optional official code - source to be confirmed.
  externalCode  String?
  nameEn        String
  nameHi        String?
  /// Distance from the root (root = 0). Maintained together with AreaClosure.
  depth         Int
  isActive      Boolean   @default(true)
  deactivatedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  level    AreaLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  parent   Area?     @relation("AreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  subAreas Area[]    @relation("AreaTree")

  /// Closure rows where this area is the DESCENDANT (i.e. its ancestors, incl. itself).
  ancestorLinks   AreaClosure[] @relation("ClosureDescendant")
  /// Closure rows where this area is the ANCESTOR (i.e. its descendants, incl. itself).
  descendantLinks AreaClosure[] @relation("ClosureAncestor")

  assignments        WorkerAreaAssignment[]
  registeredChildren Child[]
  transfersOut       ChildAreaTransfer[]    @relation("TransferFrom")
  transfersIn        ChildAreaTransfer[]    @relation("TransferTo")
  screeningSessions  ScreeningSession[]
  referrals          Referral[]
  facilities         Facility[]
  clinicalReviews    ClinicalReview[]

  @@unique([parentId, code])
  @@unique([levelId, externalCode])
  @@index([parentId])
  @@index([levelId, isActive])
}

model AreaClosure {
  ancestorId   String @db.Uuid
  descendantId String @db.Uuid
  /// 0 = the area itself.
  depth        Int

  ancestor   Area @relation("ClosureAncestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Area @relation("ClosureDescendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId, ancestorId])
}

model WorkerAreaAssignment {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  areaId             String           @db.Uuid
  roleId             String           @db.Uuid
  scope              AssignmentScope
  status             AssignmentStatus @default(ACTIVE)
  effectiveFrom      DateTime         @db.Timestamptz(3)
  /// Exclusive end; null = open-ended.
  effectiveTo        DateTime?        @db.Timestamptz(3)
  reason             String?
  createdById        String           @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  statusChangedById  String?          @db.Uuid
  statusChangedAt    DateTime?        @db.Timestamptz(3)
  statusChangeReason String?

  user            User  @relation("AssignmentHolder", fields: [userId], references: [id], onDelete: Restrict)
  area            Area  @relation(fields: [areaId], references: [id], onDelete: Restrict)
  role            Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy       User  @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  statusChangedBy User? @relation("AssignmentStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict)

  @@index([userId, status, effectiveFrom])
  @@index([areaId, status])
  @@index([roleId])
}

// ===================================================================== Children

model Child {
  id             String     @id @default(uuid()) @db.Uuid
  /// Current area. Must be an area whose level allowsChildRegistration.
  areaId         String     @db.Uuid
  fullName       String
  dateOfBirth    DateTime   @db.Date
  dobIsEstimated Boolean    @default(false)
  sexAtBirth     SexAtBirth
  createdById    String     @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?  @db.Timestamptz(3)
  deletionReason String?

  area      Area @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  guardians         ChildGuardian[]
  consents          Consent[]
  transfers         ChildAreaTransfer[]
  screeningSessions ScreeningSession[]
  measurements      Measurement[]
  referrals         Referral[]
  followUps         FollowUp[]
  media             MediaMetadata[]

  @@index([areaId, deletedAt])
  @@index([areaId, dateOfBirth])
}

model ChildAreaTransfer {
  id              String   @id @default(uuid()) @db.Uuid
  childId         String   @db.Uuid
  fromAreaId      String   @db.Uuid
  toAreaId        String   @db.Uuid
  transferredById String   @db.Uuid
  transferredAt   DateTime @default(now()) @db.Timestamptz(3)
  reason          String?

  child         Child @relation(fields: [childId], references: [id], onDelete: Restrict)
  fromArea      Area  @relation("TransferFrom", fields: [fromAreaId], references: [id], onDelete: Restrict)
  toArea        Area  @relation("TransferTo", fields: [toAreaId], references: [id], onDelete: Restrict)
  transferredBy User  @relation(fields: [transferredById], references: [id], onDelete: Restrict)

  @@index([childId, transferredAt])
}

model Guardian {
  id                String    @id @default(uuid()) @db.Uuid
  fullName          String
  /// AES-256-GCM ciphertext (application-level key) - proposed, see open decisions.
  phoneEncrypted    Bytes?
  /// HMAC-SHA256 of the normalised number, for duplicate search without decrypting.
  phoneLookupHash   String?
  preferredLanguage String    @default("hi")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  children ChildGuardian[]
  consents Consent[]

  @@index([phoneLookupHash])
}

/// One row per link PERIOD (Step 5, decision B): ending a link keeps the row, and re-linking the
/// same guardian creates a new row. SQL additions (not expressible in Prisma 6), see the
/// 20261121150000_step5 migration:
///   - at most one ACTIVE link per (childId, guardianId)        child_guardian_one_active_link
///   - at most one ACTIVE primary contact per child             child_guardian_one_primary
///   - endedById / endReason only on an ended link              child_guardian_end_complete
model ChildGuardian {
  id               String               @id @default(uuid()) @db.Uuid
  childId          String               @db.Uuid
  guardianId       String               @db.Uuid
  relationship     GuardianRelationship
  isPrimaryContact Boolean              @default(false)
  /// Worker's declaration that this person may give consent - not a legal verification.
  canGiveConsent   Boolean              @default(false)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  createdById      String?              @db.Uuid
  endedAt          DateTime?            @db.Timestamptz(3)
  endedById        String?              @db.Uuid
  /// Short reason. Must not contain personal data.
  endReason        String?

  child     Child    @relation(fields: [childId], references: [id], onDelete: Restrict)
  guardian  Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("GuardianLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy   User?    @relation("GuardianLinkEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([childId, endedAt])
  @@index([guardianId])
}

// ====================================================================== Consent

model ConsentTemplate {
  id                String         @id @default(uuid()) @db.Uuid
  purpose           ConsentPurpose
  version           Int
  languageCode      String
  /// SHA-256 of the exact approved wording shown to the guardian.
  textSha256        String
  status            ApprovalStatus @default(DRAFT)
  approvalReference String?
  approvedAt        DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)

  consents Consent[]

  @@unique([purpose, version, languageCode])
}

/// Append-only (Step 5, decision B): a database trigger rejects DELETE and every UPDATE except a
/// one-time withdrawal of a GRANTED record. The runtime account has no TRUNCATE right.
model Consent {
  id                String          @id @default(uuid()) @db.Uuid
  childId           String          @db.Uuid
  guardianId        String          @db.Uuid
  purpose           ConsentPurpose
  decision          ConsentDecision
  method            ConsentMethod
  templateId        String          @db.Uuid
  /// Paper form number or similar - no personal data.
  evidenceReference String?
  recordedById      String          @db.Uuid
  recordedAt        DateTime        @db.Timestamptz(3)
  withdrawnAt       DateTime?       @db.Timestamptz(3)
  withdrawnById     String?         @db.Uuid
  /// How the guardian communicated the withdrawal (Step 5, decision B).
  withdrawalMethod  ConsentMethod?
  withdrawalReason  String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  child       Child           @relation(fields: [childId], references: [id], onDelete: Restrict)
  guardian    Guardian        @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  template    ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recordedBy  User            @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  withdrawnBy User?           @relation("ConsentWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)

  media             MediaMetadata[]
  aiAnalyses        AiAnalysis[]
  screeningSessions ScreeningSession[]
  /// Referrals issued under this REFERRAL_DATA_SHARING consent (Step 7 decision M).
  referralsShared   Referral[]

  @@index([childId, purpose, recordedAt])
  @@index([guardianId])
}

// ==================================================================== Screening

/// One versioned protocol = one Four-D category + one age band (Step 6 decision A).
/// SQL additions (migration 20261122120000_step6_screening_foundation), not expressible in Prisma:
///   - screening_protocol_protect: content frozen once the protocol leaves DRAFT; status moves
///     only along DRAFT -> IN_REVIEW -> APPROVED -> ACTIVE -> RETIRED (IN_REVIEW -> DRAFT allowed)
///   - CHECKs: approval fields + content hash required from APPROVED on; demonstration content
///     can never be approved; retiredAt iff RETIRED
///   - screening_protocol_one_active_per_band: ACTIVE protocols of a category never overlap in age
model ScreeningProtocol {
  id                   String         @id @default(uuid()) @db.Uuid
  code                 String
  version              Int
  category             FourDCategory
  nameEn               String
  nameHi               String
  descriptionEn        String?
  descriptionHi        String?
  /// Inclusive age band in completed days.
  ageMinDays           Int
  ageMaxDays           Int
  /// Required: guideline document, edition and section the protocol is based on.
  sourceReference      String
  status               ProtocolStatus @default(DRAFT)
  /// Engineering placeholder content: never operational, can never be approved.
  isDemonstration      Boolean        @default(false)
  /// SHA-256 of the canonical protocol content and questions, fixed when it leaves DRAFT.
  contentSha256        String?
  clinicalApprovedById String?        @db.Uuid
  clinicalApprovedAt   DateTime?      @db.Timestamptz(3)
  /// Clinical approval document / committee minute reference.
  approvalReference    String?
  effectiveFrom        DateTime?      @db.Timestamptz(3)
  retiredAt            DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  clinicalApprovedBy User? @relation(fields: [clinicalApprovedById], references: [id], onDelete: Restrict)

  questions         ScreeningQuestion[]
  /// Pre-Step-6 link (one protocol per session). Deprecated, always null since Step 6.
  sessions          ScreeningSession[]
  sessionCategories ScreeningSessionCategory[]
  results           ScreeningResult[]

  @@unique([code, version])
  @@index([status, ageMinDays, ageMaxDays])
  @@index([category, status, ageMinDays, ageMaxDays])
}

/// Questions of a protocol version. Immutable once the protocol leaves DRAFT (trigger
/// screening_question_protect); category must equal the protocol's category.
model ScreeningQuestion {
  id          String        @id @default(uuid()) @db.Uuid
  protocolId  String        @db.Uuid
  code        String
  category    FourDCategory
  /// Questions are shown one section at a time.
  sectionCode String
  sortOrder   Int
  /// Stable text code (not displayed). Approved wording is `prompt`, frozen with the version.
  promptKey   String
  helpKey     String?
  /// { "hi": "...", "en": "..." } - the exact approved wording (Step 6 decision C).
  prompt      Json
  help        Json?
  answerType  AnswerType
  /// Choice questions: [{ "code": "...", "label": { "hi": "...", "en": "..." } }].
  options     Json?
  /// Protocol-defined input rules, e.g. { "min": 0, "max": 30, "maxDecimals": 0, "unit": "days" }.
  validation  Json?
  isRequired  Boolean       @default(true)

  protocol         ScreeningProtocol          @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  observations     ScreeningObservation[]
  amendmentChanges ScreeningAmendmentChange[]

  @@unique([protocolId, code])
  @@index([protocolId, sortOrder])
}

/// One screening visit. SQL additions: one open (DRAFT/IN_PROGRESS) session per child; final
/// (COMPLETED/CANCELLED) sessions and everything in them are immutable; no deletes; `version`
/// must increase by exactly 1 on every update (optimistic locking); the screening consent must be
/// a GRANTED, not withdrawn SCREENING consent of the same child.
model ScreeningSession {
  id                  String        @id @default(uuid()) @db.Uuid
  childId             String        @db.Uuid
  /// Deprecated (pre-Step-6 single protocol per session). Always null; see categories.
  protocolId          String?       @db.Uuid
  conductedById       String        @db.Uuid
  /// Snapshot of the child's area when the session started (for reporting history).
  areaId              String        @db.Uuid
  /// Server-calculated (India calendar date), never taken from the app.
  ageInDaysAtStart    Int
  dateOfBirthAtStart  DateTime      @db.Date
  dobEstimatedAtStart Boolean
  /// The SCREENING consent the session relied on when it started.
  screeningConsentId  String        @db.Uuid
  status              SessionStatus @default(DRAFT)
  startedAt           DateTime      @db.Timestamptz(3)
  completedAt         DateTime?     @db.Timestamptz(3)
  cancelledAt         DateTime?     @db.Timestamptz(3)
  cancelledById       String?       @db.Uuid
  /// Short reason. Must not contain personal data.
  cancelReason        String?
  /// Optimistic lock: clients send the version they saw; stale writes are refused (409).
  version             Int           @default(1)
  /// Device-generated id; makes a repeated "start screening" idempotent.
  clientOperationId   String?       @unique @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  child            Child              @relation(fields: [childId], references: [id], onDelete: Restrict)
  protocol         ScreeningProtocol? @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  conductedBy      User               @relation("SessionConductedBy", fields: [conductedById], references: [id], onDelete: Restrict)
  cancelledBy      User?              @relation("SessionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  area             Area               @relation(fields: [areaId], references: [id], onDelete: Restrict)
  screeningConsent Consent            @relation(fields: [screeningConsentId], references: [id], onDelete: Restrict)

  categories       ScreeningSessionCategory[]
  amendments       ScreeningAmendment[]
  observations     ScreeningObservation[]
  measurements     Measurement[]
  resultRuns       ScreeningResultRun[]
  aiAnalyses       AiAnalysis[]
  referrals        Referral[]
  followUps        FollowUp[]
  media            MediaMetadata[]
  screeningResults ScreeningResult[]

  @@index([childId, startedAt])
  @@index([areaId, status, startedAt])
  @@index([conductedById, startedAt])
  @@index([conductedById, status, updatedAt])
}

/// One Four-D category screened in a session, with the exact protocol version used
/// (Step 6 decision A). A category that was never started has no row ("not assessed").
model ScreeningSessionCategory {
  id                    String           @id @default(uuid()) @db.Uuid
  sessionId             String           @db.Uuid
  category              FourDCategory
  protocolId            String           @db.Uuid
  /// Protocol status when the category started: proves whether approved content was used.
  protocolStatusAtStart ProtocolStatus
  status                CategoryProgress @default(IN_PROGRESS)
  /// Free-text worker observations for this category. Never logged.
  notes                 String?
  startedAt             DateTime         @db.Timestamptz(3)
  completedAt           DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  session          ScreeningSession           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  protocol         ScreeningProtocol          @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  observations     ScreeningObservation[]
  amendmentChanges ScreeningAmendmentChange[]
  results          ScreeningResult[]

  @@unique([sessionId, category])
  @@index([protocolId])
}

/// The answer to one question (the "screening response"). No row = not answered.
model ScreeningObservation {
  id                String            @id @default(uuid()) @db.Uuid
  sessionId         String            @db.Uuid
  sessionCategoryId String            @db.Uuid
  questionId        String            @db.Uuid
  status            ObservationStatus
  source            ResponseSource
  valueBoolean      Boolean?
  valueCode         String?
  valueCodes        String[]
  valueNumber       Decimal?          @db.Decimal(10, 3)
  valueText         String?
  notAssessedReason String?
  /// Never logged.
  notes             String?
  recordedById      String            @db.Uuid
  recordedAt        DateTime          @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  session         ScreeningSession         @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sessionCategory ScreeningSessionCategory @relation(fields: [sessionCategoryId], references: [id], onDelete: Restrict)
  question        ScreeningQuestion        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  recordedBy      User                     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@index([questionId])
  @@index([sessionCategoryId])
}

/// Insert-only (Step 6 decision I): a correction is a NEW row that supersedes the old one, with a
/// reason; nothing is overwritten. A trigger keeps childId equal to the session's child.
model Measurement {
  id               String             @id @default(uuid()) @db.Uuid
  childId          String             @db.Uuid
  sessionId        String?            @db.Uuid
  type             MeasurementType
  /// The value exactly as entered, in `unit` (never converted on storage).
  value            Decimal            @db.Decimal(8, 2)
  /// Allowed units per type are validated in the API (kg/g, cm/mm).
  unit             String
  source           MeasurementSource
  method           String?
  deviceMake       String?
  deviceModel      String?
  deviceSerial     String?
  quality          MeasurementQuality
  measuredAt       DateTime           @db.Timestamptz(3)
  recordedById     String             @db.Uuid
  /// The measurement this row corrects.
  supersedesId     String?            @unique @db.Uuid
  correctionReason String?
  /// Never logged.
  notes            String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)

  child            Child                      @relation(fields: [childId], references: [id], onDelete: Restrict)
  session          ScreeningSession?          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  recordedBy       User                       @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  supersedes       Measurement?               @relation("MeasurementCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy     Measurement?               @relation("MeasurementCorrection")
  amendmentChanges ScreeningAmendmentChange[]

  @@index([childId, type, measuredAt])
  @@index([sessionId])
}

// ============================================== Step 7: clinical rules, results, review

/// A versioned clinical rule set for ONE Four-D category, protocol code and age band (Step 7
/// decision B). The rules are DATA in `definition` (validated by the rule DSL in
/// shared-contracts/clinicalRules.ts). SQL additions (migration 20261124100000_step7_...):
///   - clinical_rule_set_protect: content frozen once it leaves DRAFT or is used by a result;
///     status moves only DRAFT -> IN_REVIEW -> APPROVED -> ACTIVE -> RETIRED (IN_REVIEW -> DRAFT)
///   - CHECKs: approval fields + hash from APPROVED on; demonstration sets can never be approved
///   - clinical_rule_set_one_active_per_band: ACTIVE sets of one category + protocol code never
///     overlap in age
/// There is NO HTTP endpoint that changes rule sets: CLI scripts only (decision B).
model ClinicalRuleSet {
  id                String         @id @default(uuid()) @db.Uuid
  code              String
  version           Int
  category          FourDCategory
  /// Rules refer to question codes of this protocol code, in the listed protocol versions only.
  protocolCode      String
  protocolVersions  Int[]
  nameEn            String
  nameHi            String
  /// Inclusive age band in completed days.
  ageMinDays        Int
  ageMaxDays        Int
  /// Required: guideline document, edition and section behind EVERY threshold in the set.
  sourceReference   String
  definition        Json
  status            ProtocolStatus @default(DRAFT)
  /// Engineering placeholder rules: never operational, can never be approved.
  isDemonstration   Boolean        @default(false)
  /// SHA-256 of the canonical definition, fixed when the set leaves DRAFT.
  contentSha256     String?
  approvedById      String?        @db.Uuid
  approvedAt        DateTime?      @db.Timestamptz(3)
  approvalReference String?
  effectiveFrom     DateTime?      @db.Timestamptz(3)
  retiredAt         DateTime?      @db.Timestamptz(3)
  /// null only for demonstration rule sets created by the development seed (CHECK).
  createdById       String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  createdBy  User?                  @relation("RuleSetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?                  @relation("RuleSetApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  events     ClinicalRuleSetEvent[]
  results    ScreeningResult[]

  @@unique([code, version])
  @@index([category, status, ageMinDays, ageMaxDays])
}

/// Change history of a rule set (append-only).
model ClinicalRuleSetEvent {
  id            String           @id @default(uuid()) @db.Uuid
  ruleSetId     String           @db.Uuid
  type          RuleSetEventType
  fromStatus    ProtocolStatus?
  toStatus      ProtocolStatus
  /// null only for the development seed creating demonstration rule sets.
  actorId       String?          @db.Uuid
  /// Approval document / committee minute reference (no personal data).
  reference     String?
  /// SHA-256 of the definition at the time of the event.
  contentSha256 String?
  occurredAt    DateTime         @default(now()) @db.Timestamptz(3)

  ruleSet ClinicalRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  actor   User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ruleSetId, occurredAt])
}

/// Session-level result of ONE screening version (Step 7 decision F). Generated in the same
/// transaction as completion (version 1) and each amendment (version n + 1). Immutable except a
/// one-time `supersededAt` when the next version's run is created.
model ScreeningResultRun {
  id                    String        @id @default(uuid()) @db.Uuid
  sessionId             String        @db.Uuid
  /// 1 = as completed; n + 1 after amendment n.
  screeningVersion      Int
  /// Most cautious category outcome.
  overallOutcome        ResultOutcome
  /// True when any category used content or rules that are not ACTIVE and clinically approved.
  usesUnapprovedContent Boolean
  /// Evaluator code version, e.g. "rule-engine/1".
  engineVersion         String
  /// null = generated automatically on completion / amendment.
  generatedById         String?       @db.Uuid
  generatedAt           DateTime      @db.Timestamptz(3)
  supersededAt          DateTime?     @db.Timestamptz(3)

  session     ScreeningSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  generatedBy User?             @relation(fields: [generatedById], references: [id], onDelete: Restrict)
  results     ScreeningResult[]
  review      ClinicalReview?

  @@unique([sessionId, screeningVersion])
  @@index([generatedAt])
}

/// Result of ONE Four-D category in one result run. Insert-only. Evidence holds REFERENCES to the
/// recorded data (observation / measurement / amendment change ids), never copied values.
model ScreeningResult {
  id                  String           @id @default(uuid()) @db.Uuid
  resultRunId         String           @db.Uuid
  sessionId           String           @db.Uuid
  category            FourDCategory
  /// null when the category was not assessed.
  sessionCategoryId   String?          @db.Uuid
  protocolId          String?          @db.Uuid
  /// null = no rule set applied (NOT_ASSESSED / NOT_INTERPRETED).
  ruleSetId           String?          @db.Uuid
  outcome             ResultOutcome
  source              ResultSource
  aiAnalysisId        String?          @db.Uuid
  /// [{ ruleId, result: "MET" | "NOT_MET" | "UNKNOWN", evidence: [{ kind, id }] }]
  evidence            Json
  /// [{ code, ... }] - why the result is limited (incomplete, unknown answers, ...).
  limitations         Json
  referralRecommended Boolean          @default(false)
  suggestedPriority   ReferralUrgency?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  resultRun       ScreeningResultRun        @relation(fields: [resultRunId], references: [id], onDelete: Restrict)
  session         ScreeningSession          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sessionCategory ScreeningSessionCategory? @relation(fields: [sessionCategoryId], references: [id], onDelete: Restrict)
  protocol        ScreeningProtocol?        @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  ruleSet         ClinicalRuleSet?          @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  aiAnalysis      AiAnalysis?               @relation(fields: [aiAnalysisId], references: [id], onDelete: Restrict)
  referrals       Referral[]

  @@unique([resultRunId, category])
  @@index([sessionId])
  @@index([ruleSetId])
}

/// One clinical review per result run (Step 7 decision H). Claimed by one reviewer at a time.
model ClinicalReview {
  id                String                  @id @default(uuid()) @db.Uuid
  resultRunId       String                  @unique @db.Uuid
  /// Snapshot of the child's area when the task was created (reporting only; access follows the child).
  areaId            String                  @db.Uuid
  status            ClinicalReviewStatus    @default(PENDING_REVIEW)
  claimedById       String?                 @db.Uuid
  claimedAt         DateTime?               @db.Timestamptz(3)
  decision          ClinicalReviewDecision?
  decidedById       String?                 @db.Uuid
  /// Role code of the decider at decision time.
  decidedByRoleCode String?
  decidedAt         DateTime?               @db.Timestamptz(3)
  /// Encrypted (enc1:). Required for every decision except ACCEPT_RESULT.
  notes             String?
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)

  resultRun ScreeningResultRun    @relation(fields: [resultRunId], references: [id], onDelete: Restrict)
  area      Area                  @relation(fields: [areaId], references: [id], onDelete: Restrict)
  claimedBy User?                 @relation("ReviewClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict)
  decidedBy User?                 @relation("ReviewDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  events    ClinicalReviewEvent[]
  referrals Referral[]
  followUps FollowUp[]

  @@index([status, createdAt])
  @@index([areaId, status])
}

/// Append-only history of a review (created, claimed, released, decided).
model ClinicalReviewEvent {
  id            String                  @id @default(uuid()) @db.Uuid
  reviewId      String                  @db.Uuid
  fromStatus    ClinicalReviewStatus?
  toStatus      ClinicalReviewStatus
  decision      ClinicalReviewDecision?
  /// null = created by the system together with the result run.
  actorId       String?                 @db.Uuid
  actorRoleCode String?
  /// Encrypted (enc1:).
  notes         String?
  occurredAt    DateTime                @default(now()) @db.Timestamptz(3)

  review ClinicalReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actor  User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reviewId, occurredAt])
}

model AiAnalysis {
  id                  String           @id @default(uuid()) @db.Uuid
  sessionId           String           @db.Uuid
  /// The AI_PROCESSING consent that authorised this call.
  consentId           String           @db.Uuid
  analysisType        AiAnalysisType
  requestId           String           @unique
  contractVersion     String
  modelName           String?
  modelVersion        String?
  /// true = development mock response, never shown as a real result.
  isMock              Boolean
  status              AiAnalysisStatus
  inputQuality        String?
  output              Json?
  humanReviewRequired Boolean          @default(true)
  errorCode           String?
  requestedAt         DateTime         @db.Timestamptz(3)
  completedAt         DateTime?        @db.Timestamptz(3)

  session ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  consent Consent          @relation(fields: [consentId], references: [id], onDelete: Restrict)

  results ScreeningResult[]

  @@index([sessionId])
  @@index([consentId])
}

/// One amendment = one new VERSION of a COMPLETED screening (Step 6G; docs/step-6/amendment-design.md).
/// Append-only: the completed screening rows are never changed. SQL additions (migration
/// 20261123100000_step6g_screening_amendments): only for COMPLETED sessions; sequence = last + 1;
/// no DELETE; the only UPDATE is a one-time PENDING -> REVIEWED review.
model ScreeningAmendment {
  id                    String                @id @default(uuid()) @db.Uuid
  sessionId             String                @db.Uuid
  /// 1 for the first amendment (version 2 of the screening), 2 for the next, ...
  sequence              Int
  amendedById           String                @db.Uuid
  amendedAt             DateTime              @db.Timestamptz(3)
  basis                 AmendmentBasis
  /// Mandatory. Encrypted (enc1:), bound to the session and amendment.
  reason                String
  clinicallySignificant Boolean
  reviewStatus          AmendmentReviewStatus
  reviewedById          String?               @db.Uuid
  reviewedAt            DateTime?             @db.Timestamptz(3)
  /// Encrypted (enc1:).
  reviewNotes           String?
  /// Device-generated id: a retried submission returns the first amendment.
  clientOperationId     String?               @unique @db.Uuid
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)

  session    ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  amendedBy  User             @relation("AmendmentAuthor", fields: [amendedById], references: [id], onDelete: Restrict)
  reviewedBy User?            @relation("AmendmentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  changes         ScreeningAmendmentChange[]
  referralImpacts ScreeningAmendmentReferralImpact[]

  @@unique([sessionId, sequence])
  @@index([reviewStatus, amendedAt])
}

/// One changed item inside an amendment: exact old and new values. Append-only.
model ScreeningAmendmentChange {
  id                    String              @id @default(uuid()) @db.Uuid
  amendmentId           String              @db.Uuid
  kind                  AmendmentChangeKind
  sessionCategoryId     String?             @db.Uuid
  questionId            String?             @db.Uuid
  measurementId         String?             @db.Uuid
  /// Previous / new value; free-text parts encrypted. null = "not answered" / "no notes".
  oldValue              Json?
  newValue              Json?
  clinicallySignificant Boolean

  amendment       ScreeningAmendment        @relation(fields: [amendmentId], references: [id], onDelete: Restrict)
  sessionCategory ScreeningSessionCategory? @relation(fields: [sessionCategoryId], references: [id], onDelete: Restrict)
  question        ScreeningQuestion?        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  measurement     Measurement?              @relation(fields: [measurementId], references: [id], onDelete: Restrict)

  @@index([amendmentId])
}

/// A referral made from an earlier version that must be reassessed (decision G9). The referral
/// itself is never changed, so its historical context is kept. Shown by the Step 7 referral module.
model ScreeningAmendmentReferralImpact {
  id                        String             @id @default(uuid()) @db.Uuid
  amendmentId               String             @db.Uuid
  referralId                String             @db.Uuid
  referralStatusAtAmendment ReferralStatus
  reassessmentStatus        ReassessmentStatus @default(PENDING)
  reassessedById            String?            @db.Uuid
  reassessedAt              DateTime?          @db.Timestamptz(3)

  amendment    ScreeningAmendment @relation(fields: [amendmentId], references: [id], onDelete: Restrict)
  referral     Referral           @relation(fields: [referralId], references: [id], onDelete: Restrict)
  reassessedBy User?              @relation(fields: [reassessedById], references: [id], onDelete: Restrict)

  @@unique([amendmentId, referralId])
  @@index([referralId, reassessmentStatus])
}

// ===================================================== Facilities, referrals, follow-up

/// Referral destination (Step 7 decision P). State / district / block come from the area tree.
/// SQL additions: unique official code; unique (area, type, lower(name)); acceptsReferrals and
/// services only when VERIFIED; no DELETE; version +1 on every update.
model Facility {
  id                    String             @id @default(uuid()) @db.Uuid
  name                  String
  nameHi                String?
  /// Official facility code (e.g. a national facility registry id) - source to be confirmed.
  officialCode          String?            @unique
  type                  FacilityType
  areaId                String             @db.Uuid
  address               String?
  /// Facility's official phone - not personal data.
  contactPhone          String?
  /// Service codes, only as verified with the facility (never assumed).
  services              String[]           @default([])
  /// May be offered as a referral destination: only for a VERIFIED facility.
  acceptsReferrals      Boolean            @default(false)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  verifiedById          String?            @db.Uuid
  verifiedAt            DateTime?          @db.Timestamptz(3)
  verificationReference String?
  isActive              Boolean            @default(true)
  deactivatedAt         DateTime?          @db.Timestamptz(3)
  deactivationReason    String?
  version               Int                @default(1)
  createdById           String             @db.Uuid
  updatedById           String?            @db.Uuid
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  area         Area                  @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("FacilityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?                 @relation("FacilityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  verifiedBy   User?                 @relation("FacilityVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  history      FacilityHistory[]
  referrals    Referral[]
  statusEvents ReferralStatusEvent[]

  @@index([areaId, type, isActive])
  @@index([verificationStatus, acceptsReferrals, isActive])
}

/// Append-only change history of a facility (old/new values of changed fields).
model FacilityHistory {
  id         String   @id @default(uuid()) @db.Uuid
  facilityId String   @db.Uuid
  /// CREATED, UPDATED, VERIFIED, UNVERIFIED, DEACTIVATED, REACTIVATED
  action     String
  changes    Json
  reason     String?
  actorId    String   @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([facilityId, occurredAt])
}

/// A referral (Step 7 decisions J-N). SQL additions: state machine trigger (every status change
/// must follow docs/step-7/architecture.md section 6 and be accompanied by a status event);
/// one active referral per child + screening + category; ISSUED and later need a facility,
/// issue time and the REFERRAL_DATA_SHARING consent; version +1; no DELETE.
model Referral {
  id                           String          @id @default(uuid()) @db.Uuid
  childId                      String          @db.Uuid
  sessionId                    String?         @db.Uuid
  /// The category result this referral is based on, if any.
  screeningResultId            String?         @db.Uuid
  clinicalReviewId             String?         @db.Uuid
  origin                       ReferralOrigin
  /// Required from ISSUED on.
  facilityId                   String?         @db.Uuid
  /// Snapshot of the child's area at referral time.
  areaId                       String          @db.Uuid
  category                     FourDCategory?
  /// Shown as "priority". Labels only - meaning is defined by clinical policy.
  urgency                      ReferralUrgency
  status                       ReferralStatus  @default(PENDING_APPROVAL)
  reasonCode                   String
  /// Encrypted (enc1:).
  reasonNote                   String?
  approvedById                 String?         @db.Uuid
  approvedAt                   DateTime?       @db.Timestamptz(3)
  issuedAt                     DateTime?       @db.Timestamptz(3)
  /// The REFERRAL_DATA_SHARING consent verified at ISSUE.
  sharingConsentId             String?         @db.Uuid
  consentVerifiedAt            DateTime?       @db.Timestamptz(3)
  consentWithdrawnAfterIssueAt DateTime?       @db.Timestamptz(3)
  /// Encrypted (enc1:). Required when the facility is outside the child's district.
  outOfDistrictReason          String?
  appointmentAt                DateTime?       @db.Timestamptz(3)
  closedAt                     DateTime?       @db.Timestamptz(3)
  /// Device-generated id; makes a retried submission idempotent.
  clientOperationId            String?         @unique @db.Uuid
  version                      Int             @default(1)
  createdById                  String          @db.Uuid
  createdAt                    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime        @updatedAt @db.Timestamptz(3)

  child           Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  session         ScreeningSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  screeningResult ScreeningResult?  @relation(fields: [screeningResultId], references: [id], onDelete: Restrict)
  clinicalReview  ClinicalReview?   @relation(fields: [clinicalReviewId], references: [id], onDelete: Restrict)
  facility        Facility?         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  area            Area              @relation(fields: [areaId], references: [id], onDelete: Restrict)
  sharingConsent  Consent?          @relation(fields: [sharingConsentId], references: [id], onDelete: Restrict)
  approvedBy      User?             @relation("ReferralApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy       User              @relation("ReferralCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  statusEvents     ReferralStatusEvent[]
  amendmentImpacts ScreeningAmendmentReferralImpact[]
  followUps        FollowUp[]

  @@index([childId])
  @@index([areaId, status])
  @@index([facilityId, status])
  @@index([status, updatedAt])
}

/// Append-only referral history. Reports from outside the app carry a source and verification.
model ReferralStatusEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  referralId         String               @db.Uuid
  fromStatus         ReferralStatus?
  toStatus           ReferralStatus
  changedById        String               @db.Uuid
  actorRoleCode      String
  changedAt          DateTime             @default(now()) @db.Timestamptz(3)
  source             ReferralUpdateSource
  verificationStatus VerificationStatus
  /// When it happened according to the source (e.g. the visit date); changedAt = when entered.
  effectiveAt        DateTime?            @db.Timestamptz(3)
  facilityId         String?              @db.Uuid
  /// This event corrects (reverts) that earlier event (decision J).
  correctsEventId    String?              @unique @db.Uuid
  /// Encrypted (enc1:). Required for REJECTED, CANCELLED, CLOSED and corrections.
  reason             String?
  /// Encrypted (enc1:).
  note               String?

  referral      Referral             @relation(fields: [referralId], references: [id], onDelete: Restrict)
  changedBy     User                 @relation(fields: [changedById], references: [id], onDelete: Restrict)
  facility      Facility?            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  correctsEvent ReferralStatusEvent? @relation("ReferralEventCorrection", fields: [correctsEventId], references: [id], onDelete: Restrict)
  correctedBy   ReferralStatusEvent? @relation("ReferralEventCorrection")

  @@index([referralId, changedAt])
}

/// A follow-up task (Step 7 decision Q). SQL additions: one active task per child + referral +
/// reason; ASSIGNED / IN_PROGRESS need an assignee; COMPLETED needs completion fields; linked
/// session / referral / review must belong to the same child; version +1; no DELETE.
model FollowUp {
  id                 String         @id @default(uuid()) @db.Uuid
  childId            String         @db.Uuid
  referralId         String?        @db.Uuid
  screeningSessionId String?        @db.Uuid
  clinicalReviewId   String?        @db.Uuid
  reasonCode         String
  /// Encrypted (enc1:).
  reasonNote         String?
  dueDate            DateTime       @db.Date
  status             FollowUpStatus @default(PENDING)
  assignedToId       String?        @db.Uuid
  assignedById       String?        @db.Uuid
  /// Encrypted (enc1:).
  nextAction         String?
  completedAt        DateTime?      @db.Timestamptz(3)
  completedById      String?        @db.Uuid
  /// Encrypted (enc1:).
  outcomeNote        String?
  clientOperationId  String?        @unique @db.Uuid
  version            Int            @default(1)
  createdById        String         @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  child            Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  referral         Referral?         @relation(fields: [referralId], references: [id], onDelete: Restrict)
  screeningSession ScreeningSession? @relation(fields: [screeningSessionId], references: [id], onDelete: Restrict)
  clinicalReview   ClinicalReview?   @relation(fields: [clinicalReviewId], references: [id], onDelete: Restrict)
  assignedTo       User?             @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy       User?             @relation("FollowUpAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  completedBy      User?             @relation("FollowUpCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  createdBy        User              @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events           FollowUpEvent[]

  @@index([assignedToId, status, dueDate])
  @@index([childId])
  @@index([status, dueDate])
  @@index([referralId])
}

/// Append-only history of a follow-up task.
model FollowUpEvent {
  id           String            @id @default(uuid()) @db.Uuid
  followUpId   String            @db.Uuid
  type         FollowUpEventType
  fromStatus   FollowUpStatus?
  toStatus     FollowUpStatus
  actorId      String            @db.Uuid
  assignedToId String?           @db.Uuid
  oldDueDate   DateTime?         @db.Date
  newDueDate   DateTime?         @db.Date
  /// Encrypted (enc1:). Required for RESCHEDULED, MISSED, CANCELLED, REASSIGNED.
  reason       String?
  occurredAt   DateTime          @default(now()) @db.Timestamptz(3)

  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  actor      User     @relation("FollowUpEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("FollowUpEventAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([followUpId, occurredAt])
}

// ======================================================================== Media

model MediaMetadata {
  id             String         @id @default(uuid()) @db.Uuid
  childId        String         @db.Uuid
  sessionId      String?        @db.Uuid
  /// The purpose-specific consent that authorised capture.
  consentId      String         @db.Uuid
  type           MediaType
  purpose        ConsentPurpose
  /// Random key in private object storage. Never a public URL.
  storageKey     String         @unique
  mimeType       String
  sizeBytes      Int
  sha256         String
  status         MediaStatus    @default(PENDING_UPLOAD)
  capturedById   String         @db.Uuid
  capturedAt     DateTime       @db.Timestamptz(3)
  retentionUntil DateTime?      @db.Timestamptz(3)
  deletedAt      DateTime?      @db.Timestamptz(3)
  deletionReason String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  child      Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  session    ScreeningSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  consent    Consent           @relation(fields: [consentId], references: [id], onDelete: Restrict)
  capturedBy User              @relation(fields: [capturedById], references: [id], onDelete: Restrict)

  @@index([childId])
  @@index([consentId])
  @@index([status, retentionUntil])
}

// ================================================= Sessions, sync, notifications, audit

model RefreshSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  /// SHA-256 of the refresh token. The token itself is never stored.
  tokenHash     String    @unique
  /// All rotations of one login share a family; reuse of an old token revokes the family.
  familyId      String    @db.Uuid
  deviceLabel   String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?
  replacedById  String?   @unique @db.Uuid

  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  replacedBy RefreshSession? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshSession? @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model SyncOperation {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  clientOperationId String     @db.Uuid
  deviceId          String
  operationType     String
  entityType        String
  entityId          String?    @db.Uuid
  status            SyncStatus @default(RECEIVED)
  receivedAt        DateTime   @default(now()) @db.Timestamptz(3)
  appliedAt         DateTime?  @db.Timestamptz(3)
  errorCode         String?
  /// Response returned on first apply; replayed for duplicates. IDs and status only.
  responseSnapshot  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, clientOperationId])
  @@index([userId, receivedAt])
}

/// In-app notification (Step 7 decision S). IDs only - no names or health details. Only readAt
/// may change, once (trigger). dedupeKey makes reminder runs and retries idempotent.
model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  entityType String
  entityId   String           @db.Uuid
  dedupeKey  String           @unique
  /// IDs only - no names or health details.
  payload    Json
  readAt     DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
}

/// Insert-only (see SQL additions). No foreign keys, so it is independent of operational tables.
model AuditLog {
  id          String       @id @default(uuid()) @db.Uuid
  occurredAt  DateTime     @default(now()) @db.Timestamptz(3)
  actorUserId String?      @db.Uuid
  action      String
  entityType  String
  entityId    String?      @db.Uuid
  areaId      String?      @db.Uuid
  outcome     AuditOutcome
  requestId   String?
  /// Field names and non-personal values only (e.g. assignment before/after).
  details     Json?

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
}
