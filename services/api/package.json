{
  "name": "@balswasthya/api",
  "version": "0.1.0",
  "private": true,
  "description": "BalSwasthya AI backend API (Express + TypeScript + Prisma 6).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "db:bootstrap-admin": "tsx --env-file=.env prisma/bootstrap-admin.ts",
    "db:protocol-status": "tsx --env-file=.env prisma/protocol-status.ts",
    "db:protocol-import": "tsx --env-file=.env prisma/protocol-import.ts",
    "db:dev-live-worker": "tsx --env-file=.env prisma/dev-live-worker.ts",
    "db:dev-reset-password": "tsx --env-file=.env prisma/dev-reset-password.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@balswasthya/shared-contracts": "0.1.0",
    "@prisma/client": "^6.19.3",
    "argon2": "0.45.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "^8.3.0",
    "jose": "6.2.15",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
