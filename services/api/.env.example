# =====================================================================
# Backend API environment. Copy to .env:   Copy-Item .env.example .env
# This file holds SECRETS. .env is git-ignored - never commit it and never
# copy these values into the Expo app.
# =====================================================================

NODE_ENV=development
PORT=4000
# 0.0.0.0 lets a phone on the same Wi-Fi reach the API during development.
HOST=0.0.0.0

# PostgreSQL (must match the root .env used by Docker Compose; host port 5433)
DATABASE_URL=postgresql://balswasthya:change_me_local_only@127.0.0.1:5433/balswasthya_dev?schema=public

# Comma-separated browser origins allowed by CORS (Expo web dev server = 8081).
# Native mobile apps do not send an Origin header and are not affected by CORS.
CORS_ORIGINS=http://localhost:8081

# JWT signing secret - used from the authentication step onwards.
# Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Python AI service (owned by the AI team). Leave AI_SERVICE_URL empty to run
# without it - the API and screening questionnaires keep working.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=5000
