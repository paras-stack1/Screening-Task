# =====================================================================
# Backend API environment. Copy to .env:   Copy-Item .env.example .env
# This file holds SECRETS. .env is git-ignored - never commit it and never
# copy these values into the Expo app.
#
# With NODE_ENV=production the API REFUSES TO START unless:
#   - JWT_SECRET is set (32+ chars)
#   - every CORS_ORIGINS entry uses https:// (an empty list is allowed)
#   - AI_SERVICE_URL (if set) uses https:// and AI_SERVICE_API_KEY has 32+ chars
#   - DATABASE_URL has sslmode=require, verify-ca or verify-full
#   - MIGRATION_DATABASE_URL is NOT set (the runtime must not hold owner credentials)
#   - PII_ENCRYPTION_KEY and PII_LOOKUP_KEY are set (and different)
# In production, supply these from a secret manager, not a .env file.
# =====================================================================

NODE_ENV=development
PORT=4000
# 0.0.0.0 lets a phone on the same Wi-Fi reach the API during development.
HOST=0.0.0.0

# PostgreSQL - two accounts (passwords must match the root .env; host port 5433).
# Runtime account used by the API: read/write data only, cannot change tables.
# Created by `npm run db:setup-roles` (uses APP_DB_USER / APP_DB_PASSWORD from the root .env).
DATABASE_URL=postgresql://balswasthya_app:change_me_app_local_only@127.0.0.1:5433/balswasthya_dev?schema=public
# Owner account, used ONLY by Prisma Migrate. Never set this for the running API in production.
MIGRATION_DATABASE_URL=postgresql://balswasthya:change_me_local_only@127.0.0.1:5433/balswasthya_dev?schema=public
# Database-backed tests (`npm run test:db`). The database name MUST end in _test:
# the test setup wipes and re-migrates it.
TEST_DATABASE_URL=postgresql://balswasthya:change_me_local_only@127.0.0.1:5433/balswasthya_test?schema=public

# Comma-separated browser origins allowed by CORS (Expo web dev server = 8081, admin portal = 5173).
# Native mobile apps do not send an Origin header and are not affected by CORS.
# The admin portal's browser sign-in (/auth/web/*) is refused for any origin not listed here.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# --- Authentication (docs/authentication.md) ---------------------------------
# JWT signing secret (HS256). REQUIRED in every environment, 32+ characters, a DIFFERENT random
# value per environment. Changing it signs everyone out of their access tokens (refresh still works).
# Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Optional. Default issuer is "balswasthya-api:<NODE_ENV>", so tokens never cross environments.
# JWT_ISSUER=
# JWT_AUDIENCE=balswasthya-worker-app
# Access token lifetime in seconds (60-3600). Default 900 = 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900
# A session unused for this many days expires (default 14).
REFRESH_TOKEN_IDLE_DAYS=14
# Hard limit from sign-in, however often it is refreshed (default 30; must be >= idle days).
REFRESH_TOKEN_ABSOLUTE_DAYS=30
# Number of reverse proxies / load balancers in front of the API (0 = clients connect directly).
# Must be correct in deployment, or rate limiting sees the proxy's IP for every client.
TRUST_PROXY_HOPS=0

# --- Guardian phone protection (docs/api/children.md, decision D5) -------------
# AES-256-GCM key (base64 of exactly 32 random bytes) and a DIFFERENT HMAC key (base64, 32+ bytes)
# for duplicate search. REQUIRED in production. If unset in development, phone numbers cannot be
# saved (the API answers 503 PHONE_STORAGE_UNAVAILABLE). Losing PII_ENCRYPTION_KEY makes stored
# numbers unreadable; changing PII_LOOKUP_KEY breaks duplicate detection for stored numbers.
# Generate each one in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
PII_ENCRYPTION_KEY=
PII_LOOKUP_KEY=

# Step 8 Parent Portal (docs/api/parent-portal.md). PARENT_PORTAL_URL is the trusted address used
# in invitation links (https in production); empty = invitations are refused. SMS_PROVIDER:
# "none" sends nothing (production default until a real provider is approved); "mock" is for
# development only (writes to the git-ignored .dev-sms/outbox.log) and is refused in production.
PARENT_PORTAL_URL=http://localhost:8082
PARENT_INVITE_TTL_HOURS=24
SMS_PROVIDER=mock
# One-time codes (PP6): base64, 32+ bytes, different from the PII keys. Required in production;
# empty = codes cannot be sent (503). Generate with the PowerShell line above.
OTP_HMAC_KEY=
PARENT_OTP_TTL_MINUTES=5
# Parent access tokens use their own audience so staff routes reject them (must differ from JWT_AUDIENCE).
PARENT_JWT_AUDIENCE=balswasthya-parent-portal

# Python AI service (owned by the AI team). Leave AI_SERVICE_URL empty to run
# without it - the API and screening questionnaires keep working.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=5000

# fatal | error | warn | info | debug | trace | silent  (default: info; tests use silent)
LOG_LEVEL=info
