{
  // Editor, lint and test configuration (covers src + tests).
  // Tests run under Vitest (ESM, bundler-style resolution), so this file uses Bundler resolution.
  // The emitted build uses NodeNext via tsconfig.build.json; `npm run typecheck` checks both.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "prisma", "vitest.config.mts", "vitest.db.config.mts"]
}
