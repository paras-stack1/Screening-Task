{
  "expo": {
    "name": "BalSwasthya Parent Portal",
    "slug": "balswasthya-parent-app",
    "scheme": "balswasthya-parent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F8FB",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.balswasthya.parentapp"
    },
    "android": {
      "package": "com.balswasthya.parentapp",
      "adaptiveIcon": {
        "backgroundColor": "#E8F2FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-localization", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
