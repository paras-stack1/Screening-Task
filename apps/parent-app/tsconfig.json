{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // App code runs on phones: no Node or Jest globals. TypeScript 6 loads no @types/* by default.
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["tests"]
}
