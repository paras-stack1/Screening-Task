# =====================================================================
# Parent Portal app (Expo) environment. Copy to .env:   Copy-Item .env.example .env
#
# WARNING: Every EXPO_PUBLIC_* value is compiled INTO the app and can be read
# by anyone. NEVER put secrets here. They belong only in services/api/.env.
# =====================================================================

# Base URL of the Express API (including /api/v1). Plain http:// only in development.
#  - Web browser on this PC:   http://localhost:4000/api/v1
#  - Android emulator:         http://10.0.2.2:4000/api/v1
# For the web app, add its origin (e.g. http://localhost:8082) to CORS_ORIGINS in services/api/.env.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
