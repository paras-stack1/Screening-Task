# =====================================================================
# Worker app (Expo) environment. Copy to .env:   Copy-Item .env.example .env
#
# WARNING: Every EXPO_PUBLIC_* value is compiled INTO the mobile app and can be
# read by anyone who installs it. NEVER put database URLs, JWT secrets,
# passwords or AI API keys here. Those belong only in services/api/.env.
# =====================================================================

# Base URL of the Express API (including /api/v1).
#  - Web browser / iOS simulator on this PC:  http://localhost:4000/api/v1
#  - Android emulator:                        http://10.0.2.2:4000/api/v1
#  - Physical phone with Expo Go (same Wi-Fi): http://<your-PC-LAN-IP>:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
