# BalSwasthya AI admin portal - copy to .env:   Copy-Item .env.example .env
# Everything here is built into the web page and visible to anyone: NEVER put a secret here.

# API base URL, ending in /api/v1. The API's CORS_ORIGINS must list this portal's address
# (http://localhost:5173 in development). In production: https only, same site as the portal.
VITE_API_BASE_URL=http://localhost:4000/api/v1
